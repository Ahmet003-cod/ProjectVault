# ==============================================================================
# ProjectVault - Environment Variables Example
# Bu dosyayı kopyalayarak .env (yerel geliştirme) veya Netlify Environment
# Variables panelinde aşağıdaki değerleri tanımlayın.
# ==============================================================================

# Supabase Bağlantı Bilgileri (Frontend ve Backend için güvenli ortak değerler)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Supabase Service Role Key (KESİNLİKLE frontend koduna eklemeyin!)
# Yalnızca arka plan alarm zamanlayıcısı (process-reminders.js) için gereklidir.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Yapay Zekâ Sağlayıcısı (Modüler Mimari)
# Desteklenen değerler: gemini | groq | openrouter | mistral | openai_compatible
AI_PROVIDER=gemini
GEMINI_API_KEY=your-google-gemini-api-key
GROQ_API_KEY=
AI_MODEL=gemini-2.0-flash

# OpenAI uyumlu alternatif sağlayıcı ayarları (AI_PROVIDER=openai_compatible ise)
# Örnekler: Qwen (DashScope), Groq (Llama), Mistral, OpenRouter, Together AI, Ollama
AI_BASE_URL=
AI_API_KEY=

# Opsiyonel E-posta Bildirimi (Resend API)
RESEND_API_KEY=
RESEND_FROM_EMAIL=ProjectVault <onboarding@resend.dev>

# Zamanlanmış görev güvenlik anahtarı (Manuel tetikleme için)
CRON_SECRET=generate-a-long-random-secret-here

# Varsayılan Zaman Dilimi
TIMEZONE=Europe/Istanbul
